# DLB AUTO MARKETING - Environment Configuration

PORT=3001
JWT_SECRET=your_jwt_secret_change_in_production

# Meta WhatsApp Business Platform (Cloud API) Credentials
# Obtain these from developers.facebook.com -> Your App -> WhatsApp -> API Setup
META_APP_ID=
META_APP_SECRET=
META_SYSTEM_USER_TOKEN=
META_WABA_ID=
META_PHONE_NUMBER_ID=
META_WEBHOOK_VERIFY_TOKEN=dlb_webhook_token_secure_2026
META_GRAPH_API_VERSION=v21.0

# When true, realistic provider simulation runs if no live credentials provided
META_MOCK_PROVIDER=false

# Phone Number & Import Defaults
DEFAULT_COUNTRY_CODE=91
IMPORT_CHUNK_SIZE=500

# Delivery Queue Settings
QUEUE_CONCURRENCY=5
QUEUE_RATE_LIMIT_PER_SEC=20
QUEUE_MAX_RETRIES=3

# Google OAuth 2.0 & YouTube Data API v3 Credentials
# Obtain these from console.cloud.google.com -> APIs & Services -> Credentials
GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-your_google_client_secret_here
GOOGLE_REDIRECT_URI=http://localhost:3001/api/social/youtube/callback

